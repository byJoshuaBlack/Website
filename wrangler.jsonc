{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only on the custom domain, where Cloudflare Access guards /admin and /api/users.
  // A workers.dev or preview address would bypass Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "byjoshuablack.com", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "website"
    }
  ],
  // Payload's database.
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "website",
      "database_id": "2b690e35-2c71-4160-8fab-888777fc60e4"
    }
  ],
  // Files uploaded through Payload's admin.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "website-media"
    }
  ],
  // Resizes next/image photos through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Deploys keep variables set in the Cloudflare dashboard instead of deleting them.
  "keep_vars": true,
  "env": {
    // Used only by `npm run deploy:database`, so Payload's migrations reach the live database.
    // Everything else, local builds and previews included, stays on a local copy.
    "migrate": {
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "website",
          "database_id": "2b690e35-2c71-4160-8fab-888777fc60e4",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "website-media"
        }
      ]
    }
  }
}
